# Copy this file to `.env` (never commit `.env`) and fill in your own values.
# Everything below is read by the app. Server-only values must NEVER start with VITE_.

# --- Supabase (Project Settings -> API) -------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# SECRET: the server uses this to read/write the game tables. Keep it out of the browser and out of git.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# The same URL and publishable key, exposed to the browser build (safe to be public).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# --- Optional: AI word generation for "Imposter" (leave empty to disable) ---------------------
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# Or any OpenAI-compatible gateway (used only when GEMINI_API_KEY is empty)
# AI_GATEWAY_API_KEY=""
# AI_GATEWAY_URL="https://api.openai.com/v1/chat/completions"
# AI_MODEL="gpt-4o-mini"

# --- Optional: shared secret for scheduled jobs ------------------------------------------------
CRON_SECRET=""
